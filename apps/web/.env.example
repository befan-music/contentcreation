# Copy to apps/web/.env.local (git-ignored) and fill in. Restart the app after changes.

# --- Magic Stage (AI restyling via Higgsfield) ------------------------------
# Create credentials at https://console.higgsfield.ai (API keys). Format: <key id>:<secret>
HIGGSFIELD_KEY=
# Image model used to restyle photos (default: xai/grok-imagine-image-2.0).
# Alternative: ideogram/v4.0 (keeps more of the original; tune HIGGSFIELD_IMAGE_WEIGHT 1-100, default 55)
# HIGGSFIELD_IMAGE_MODEL=xai/grok-imagine-image-2.0
# HIGGSFIELD_RESOLUTION=1k
# Max photos styled per Generate press (cost guard)
# STAGES_MAGIC_MAX=40
# Local test mode without AI or credits (pixel filter, clearly labelled):
# STAGES_MAGIC_PROVIDER=mock

# --- Analytics (optional) ----------------------------------------------------
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
